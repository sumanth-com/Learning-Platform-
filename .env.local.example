# Supabase — copy to .env.local and fill in values from your project settings
# Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only needed for admin/server scripts (never expose to the client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL used for auth email redirects (local / production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Mentor (provider-agnostic). Default: gemini
AI_MENTOR_PROVIDER=gemini
AI_MENTOR_MODEL=gemini-flash-latest
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Or switch provider without UI changes:
# AI_MENTOR_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key
# AI_MENTOR_MODEL=gpt-4o-mini

# AI_MENTOR_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key
# AI_MENTOR_MODEL=claude-3-5-haiku-latest
