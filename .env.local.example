# Supabase — copy to .env.local and fill in values from your project settings
# Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for branded auth emails (generateLink + Resend). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin — single source of truth for auth redirects, canonical URLs,
# sitemap, robots.txt, Open Graph, Twitter cards, and JSON-LD.
# Local: http://localhost:3000
# Production: https://suprabase.in  (must match the live custom domain exactly)
# Also allow this origin in Supabase → Authentication → URL Configuration
#   Site URL + Redirect URLs: https://suprabase.in/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional alias kept for older deploys; SITE_URL wins when both are set
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (GA4 loads only in production when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-C98144X1EF
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxxxx

# Resend — https://resend.com/api-keys
# Verify your domain, then set EMAIL_FROM to that domain.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="SupraBase <noreply@yourdomain.com>"
EMAIL_SUPPORT=support.suprabase@gmail.com
# EMAIL_REPLY_TO=support@yourdomain.com

# AI Mentor (provider-agnostic). Default: gemini
AI_MENTOR_PROVIDER=gemini
AI_MENTOR_MODEL=gemini-flash-latest
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Or switch provider without UI changes:
# AI_MENTOR_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key
# AI_MENTOR_MODEL=gpt-4o-mini

# AI_MENTOR_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key
# AI_MENTOR_MODEL=claude-3-5-haiku-latest
